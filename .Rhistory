#! /usr/bin/env Rscript
library("rjstat")
library("tidyverse")
library("data.table")
library("optparse")
library("zoo")
library("dtplyr")
library("rjstat")
library("countrycode")
library("lubridate")
option_list <- list(
make_option(c("-d", "--date"), type = "character", default = "2026-07-01", help = "Date"),
make_option(c("-p", "--prices"), type = "character", default = "./source-data/latest-prices-jul26.csv", help = "Path to prices file"),
make_option(c("-r", "--rates"), type = "character", default = "./source-data/refinitiv-20260715.csv", help = "Path to rates file"),
make_option(c("-i", "--imf"), type = "character", default = "./source-data/WEOApr2026all.csv", help = "Path to IMF file")
)
opt <- parse_args(OptionParser(option_list = option_list))
if (is.null(opt$date)) {
stop("You must provide a date")
}
if (is.null(opt$prices)) {
stop("You must provide a prices sheet")
}
if (is.null(opt$imf)) {
stop("You must provide a WEO report path")
}
this_date <- opt$date
prices_loc <- opt$prices
rates_loc <- opt$rates
imf_loc <- opt$imf
big_mac_countries <- c(
"ARG", "AUS", "BRA", "GBR", "CAN", "CHL", "CHN", "CZE", "DNK",
"EGY", "HKG", "HUN", "IDN", "ISR", "JPN", "MYS", "MEX", "NZL",
"NOR", "PER", "PHL", "POL", "RUS", "SAU", "SGP", "ZAF", "KOR",
"SWE", "CHE", "TWN", "THA", "TUR", "ARE", "USA", "COL", "CRI",
"PAK", "LKA", "UKR", "URY", "IND", "VNM", "GTM", "HND", "VEN",
"NIC", "AZE", "BHR", "HRV", "JOR", "KWT", "LBN", "MDA", "OMN",
"QAT", "ROU", "EUZ", "AUT", "BEL", "CYP", "EST", "FIN", "FRA",
"DEU", "GRC", "IRL", "ITA", "LVA", "LTU", "LUX", "MLT", "NLD",
"PRT", "SVK", "SVN", "ESP", "BGR"
)
base_currencies <- c("USD", "EUR", "GBP", "JPY", "CNY")
euro_area <- c(
"AUT", "BEL", "BGR", "CYP", "EST", "FIN", "FRA", "DEU", "GRC", "HRV", "IRL", "ITA",
"LVA", "LTU", "LUX", "MLT", "NLD", "PRT", "SVK", "SVN", "ESP"
)
euro_price_area <- c(
"AUT", "BEL", "EST", "FIN", "FRA", "DEU", "GRC", "IRL", "ITA",
"NLD", "PRT", "ESP", "SVN", "SVK", "LVA", "LTU", "HRV", "BGR"
)
original_source_data <- fread("./output-data/big-mac-source-data-v2.csv")[date != this_date]
original_source_data[, date := as.Date(date)]
# We need to map iso_a3 codes to currency codes so we can line up with currency data
currency_map <- fread("./metadata/currency-map.csv") %>%
.[, .(iso_a3 = countrycode(country, "iso2c", "iso3c"), currency_code = currency)]
# We also need our list of country names
country_names <- fread("./metadata/country-names.csv") %>%
.[, .(name, iso_a3)] %>%
rbind(data.table(iso_a3 = "EUZ", name = "Euro area"))
if (!is_null(rates_loc)) {
exchange_rates <- fread(rates_loc, skip = 2) %>%
.[, .(currency_code = ISO, rate = `USD Mid`)]
# Some currencies, like Australia's Dollar (AUD) or New Zealand's Dollar (NZD)
# are reported in the reverse manner to the other the currencies listed—that
# is, as USD per AUD, instead of AUD per USD. We correct this here.
exchange_rates[currency_code %in% c("AUD", "NZD"), rate := 1 / rate]
# also, naturally, we have no exchange rate for the US Dollar; we add one(1)
# in now to prevent errors later
exchange_rates <- rbindlist(list(exchange_rates, list("USD", 1)))
latest_prices <- fread(prices_loc) %>%
.[, iso_a3 := countrycode(country, "country.name", "iso3c")] %>%
# merge(currency_map, by='iso_a3') %>%
.[, .(iso_a3, currency_code, local_value)] %>%
na.omit()
big_mac_prices <- merge(latest_prices, exchange_rates, by = "currency_code")
} else {
# if we _didn't_ get a rates_loc, we assume this has been bundled
# in to the prices file as is now the research dept's habit
big_mac_prices <- fread(prices_loc) %>%
.[, .(iso_a3 = country_code, currency_code, local_value, rate = exchange_rate)]
# we still have to flip these exchange rates
big_mac_prices[currency_code %in% c("AUD", "NZD"), rate := 1 / rate]
## do we need to flip GBP/EUR now?
# and for some reason the US exchange rate is... sometimes not 1
big_mac_prices[currency_code == "USD", rate := 1]
# finally we fill in the euro rate
big_mac_prices[iso_a3 == "EUR", iso_a3 := "EUZ"]
big_mac_prices[currency_code == "EUR" & is.na(rate), rate := big_mac_prices[iso_a3 == "EUZ", rate]]
big_mac_prices <- big_mac_prices %>% na.omit()
}
big_mac_prices[, dollar_value := local_value / rate] %>%
#     .[,year := this_date %>% as.Date %>% year] %>%
.[iso_a3 %in% c(big_mac_countries, euro_price_area)]
# as a sanity check
big_mac_prices[iso_a3 %in% c("USA", "GBR", "DEU", "AUS", "JPN", "CHN", "SWE", "CHE")]
# eurostatURL = 'http://ec.europa.eu/eurostat/wdds/rest/data/v2.1/json/en/tec00001?precision=1'
# eurostatURL <- "https://ec.europa.eu/eurostat/api/dissemination/statistics/1.0/data/tec00001?format=JSON&lang=EN"
eurostatURL <- "https://ec.europa.eu/eurostat/api/dissemination/statistics/1.0/data/nama_10_gdp?format=JSON&lang=EN"
if (this_date == "2024-07-01"){
print("loading manually downloaded eurostat data")
eurostatGDP_latest <- as.data.table(read.csv("euro_area_gdp_latest_pps_tmp.csv"))
eurostatGDP_latest$GDP <- as.numeric(gsub(",", "", eurostatGDP_latest$GDP))
eurostatGDP_latest$year <- 2023
eurostatGDP_latest$iso_a3 <- countrycode(eurostatGDP_latest$name, "country.name", "iso3c")
} else {
eurostatGDP <- fromJSONstat(readLines(eurostatURL)) %>% as.data.table()
eurostatGDP[`Geopolitical entity (reporting)` == "Germany (until 1990 former territory of the FRG)", `Geopolitical entity (reporting)` := "Germany"]
# eurostatGDP_latest <- eurostatGDP[!is.na(value) & `Unit of measure` == "Current prices, million euro"] %>%
eurostatGDP_latest <- eurostatGDP[
!is.na(value) &
`National accounts indicator (ESA 2010)` == "Gross domestic product at market prices" &
`Unit of measure` == "Current prices, million purchasing power standards (PPS, EU27 from 2020)"
] %>%
unique(by = "Geopolitical entity (reporting)", fromLast = T) %>%
.[, .(name = `Geopolitical entity (reporting)`, year = `Time frequency`, GDP = value, iso_a3 = countrycode(`Geopolitical entity (reporting)`, "country.name", "iso3c"))]
}
eurostatGDP_price_area <- eurostatGDP_latest[iso_a3 %in% euro_price_area] %>%
.[, weight := GDP / sum(GDP)] %>%
merge(big_mac_prices, by = "iso_a3") %>%
.[, weighted_euro_price := weight * local_value] %>%
.[, weighted_dollar_price := weight * dollar_value] %>%
.[]
euro_bigmac_local_value <- sum(eurostatGDP_price_area$weighted_euro_price) %>% round(2)
euro_exchange_rate <- big_mac_prices[currency_code == "EUR"]$rate[1]
euro_bigmac_dollar_value <- euro_bigmac_local_value / euro_exchange_rate
# add the Eurozone price to the list
big_mac_prices <- rbindlist(
list(
big_mac_prices[iso_a3 %in% big_mac_countries],
list("EUR", "EUZ", euro_bigmac_local_value, euro_exchange_rate, euro_bigmac_dollar_value)
)
)
eurozone_dates <- c(
AUT = 1999,
BEL = 1999,
FIN = 1999,
FRA = 1999,
DEU = 1999,
IRL = 1999,
ITA = 1999,
LUX = 1999,
NLD = 1999,
PRT = 1999,
ESP = 1999,
GRC = 2001,
SVN = 2007,
CYP = 2008,
MLT = 2008,
SVK = 2009,
EST = 2011,
LVA = 2014,
LTU = 2015,
HRV = 2023,
BGR = 2025
)
# read in GDP data
imf_data <- fread(imf_loc, header = TRUE) %>%
# filter using original column name
.[INDICATOR.ID %in% c("NGDPPC", "NGDPDPC", "NGDP", "NGDPD", "LP")] %>%
# rename to the "old" names
{
dt <- .
setnames(
dt,
old = c("COUNTRY.ID", "INDICATOR.ID", "LATEST_ACTUAL_ANNUAL_DATA"),
new = c("ISO", "WEO Subject Code", "Estimates Start After")
)
dt
} %>%
# KEEP ONLY: ISO, WEO Subject Code, Estimates Start After, and 1980+ columns
.[, c(
"ISO",
"WEO Subject Code",
"Estimates Start After",
names(.)[match("1980", names(.)):ncol(.)]
), with = FALSE] %>%
melt(
id.vars = c("ISO", "WEO Subject Code", "Estimates Start After"),
variable.name = "year"
)  %>%
# FIX fiscal year types like FY2024/25 → 2024
.[, `Estimates Start After` := as.numeric(
ifelse(
grepl("^FY", `Estimates Start After`),
sub("^FY([0-9]{4}).*", "\\1", `Estimates Start After`),
`Estimates Start After`
)
)] %>%
.[, .(
iso_a3 = ISO,
variable = `WEO Subject Code`,
year = year %>% as.character() %>% as.numeric(),
value = as.numeric(gsub(",", "", value)),
estimates = `Estimates Start After`
)] %>%
.[!is.na(value)] %>%
# this chunk is forward-filling the last available values
# do we actually want to do this?
# .[, value := ifelse(year > estimates, NA, value)] %>%
.[, value := ifelse(year >= year(this_date), NA, value)] %>%
.[, value := na.locf(value), by = .(iso_a3, variable)] %>%
merge(
.,
.[
iso_a3 %in% euro_area & eurozone_dates[iso_a3] <= year,
.(
iso_a3 = "EUZ",
value = ifelse(
variable %in% c("NGDPD", "NGDP", "LP"),
sum(value),
mean(value, na.rm = T)
),
estimates = min(estimates)
),
by = .(year, variable)
],
all = T
) %>%
dcast(iso_a3 + year ~ variable) %>%
.[, .(
iso_a3, year,
population = LP, NGDP, NGDPD,
NGDPDPC = ifelse(iso_a3 == "EUZ", NGDPD / LP * 1000, NGDPDPC),
NGDPPC = ifelse(iso_a3 == "EUZ", NGDP / LP * 1000, NGDPPC)
)]
imf_data[iso_a3 == "EUZ"]
big_mac_prices %>%
merge(country_names, by = "iso_a3") %>%
head()
big_mac_source_data <- original_source_data[, .(name, iso_a3, currency_code, local_price, dollar_ex, date)] %>%
rbind(
big_mac_prices %>% merge(country_names, by = "iso_a3") %>%
.[
,
.(
name, iso_a3, currency_code,
local_price = local_value, dollar_ex = rate, date = as.Date(this_date)
)
]
) %>%
### make sure we only take the newest value for any given date
.[
,
.(local_price = last(local_price), dollar_ex = last(dollar_ex), year = year(date - days(420))),
by = .(name, iso_a3, currency_code, date)
] %>%
merge(imf_data[, .(iso_a3, year, GDP_dollar = NGDPDPC, GDP_local = NGDPPC)], by = c("iso_a3", "year"), all.x = T) %>%
.[, .(
name, iso_a3, currency_code, local_price, dollar_ex, GDP_dollar, GDP_local, date
)] %>%
.[order(date)]
big_mac_source_data %>% tail()
fwrite(big_mac_source_data, "./output-data/big-mac-source-data-v2.csv")
View(big_mac_source_data)
setwd("~/big-mac-data")
library("tidyverse")
library("tidyverse")
library("data.table")
big_mac_countries <- c(
"ARG", "AUS", "BRA", "GBR", "CAN", "CHL", "CHN", "CZE", "DNK",
"EGY", "HKG", "HUN", "IDN", "ISR", "JPN", "MYS", "MEX", "NZL",
"NOR", "PER", "PHL", "POL", "RUS", "SAU", "SGP", "ZAF", "KOR",
"SWE", "CHE", "TWN", "THA", "TUR", "ARE", "USA", "COL", "CRI",
"PAK", "LKA", "UKR", "URY", "IND", "VNM", "GTM", "HND", "VEN",
"NIC", "AZE", "BHR", "JOR", "KWT", "LBN", "MDA", "OMN",
"QAT", "ROU", "EUZ"
)
big_mac_data <- fread("./source-data/big-mac-source-data-v2.csv", na.strings = "#N/A") %>%
.[!is.na(local_price)] %>% # remove lines where the local price is missing
.[, GDP_local := as.numeric(GDP_local)] %>% # convert GDP to a number
.[order(date, name)] # sort by date and then by country name, for easy reading
latest_date <- big_mac_data$date %>% max()
big_mac_data[, dollar_price := local_price / dollar_ex]
base_currencies <- c("USD", "EUR", "GBP", "JPY", "CNY")
big_mac_index <- big_mac_data[
!is.na(dollar_price) & iso_a3 %in% big_mac_countries,
.(date, iso_a3, currency_code, name, local_price, dollar_ex, dollar_price)
]
for (currency in base_currencies) {
big_mac_index[
, # we don't want a subset, so our first argument is blank
(currency) := # we'll add a new column named for the base set
dollar_price / # we divide the dollar price in each row by
# the dollar price on the *base currency*'s row (.SD is a data.table
.SD[currency_code == currency]$dollar_price - # that contains only the current group)
1, # one means parity (neither over- nor under-valued), so we subtract one
# to get an over/under-valuation value
by = date # and of course, we'll group these rows by date
]
}
big_mac_index[, (base_currencies) := round(.SD, 5L), .SDcols = base_currencies]
to_plot <- big_mac_index[date == latest_date]
to_plot$name <- factor(to_plot$name, levels = to_plot$name[order(to_plot$USD)])
fwrite(big_mac_index, "./output-data/big-mac-raw-index.csv")
big_mac_gdp_data <- big_mac_data[GDP_local > 0]
regression_countries <- c(
"ARG", "AUS", "BRA", "GBR", "CAN", "CHL", "CHN", "CZE", "DNK",
"EGY", "EUZ", "HKG", "HUN", "IDN", "ISR", "JPN", "MYS", "MEX",
"NZL", "NOR", "PER", "PHL", "POL", "RUS", "SAU", "SGP", "ZAF",
"KOR", "SWE", "CHE", "TWN", "THA", "TUR", "USA", "COL", "PAK",
"IND", "AUT", "BEL", "NLD", "FIN", "FRA", "DEU", "IRL", "ITA",
"PRT", "ESP", "GRC", "EST"
)
# in 2021, we added a number of additional countries to the adjusted index
regression_addons_2021 <- c(
"ARE", "CRI", "LKA", "UKR", "URY", "VNM", "GTM", "HND", "NIC",
"AZE", "BHR", "HRV", "JOR", "KWT", "MDA", "OMN", "QAT", "ROU",
"SVK", "SVN", "LVA", "LTU"
)
# in 2026, we added Bulgaria to the adjusted index
regression_addons_2026 <- c("BGR")
big_mac_gdp_data <- big_mac_gdp_data[iso_a3 %in% regression_countries |
(iso_a3 %in% regression_addons_2021 & date >= as.Date("2021-01-01"))|
(iso_a3 %in% regression_addons_2026 & date >= as.Date("2026-07-01"))]
big_mac_gdp_data %>%
.[, GDP_bigmac := GDP_local / (local_price / .SD[iso_a3 == "USA"]$local_price), by = date]
big_mac_gdp_data[
,
`:=`(
adj_price = lm(dollar_price ~ GDP_bigmac) %>% predict()
#         adj_price_USD=lm(dollar_price ~ GDP_dollar) %>% predict
),
by = date
]
big_mac_adj_index <- big_mac_gdp_data[
!is.na(dollar_price) &
(
iso_a3 %in% regression_countries |
iso_a3 %in% regression_addons_2021 & date >= "2021-01-01"|
iso_a3 %in% regression_addons_2026 & date >= "2026-07-01"
) &
iso_a3 %in% big_mac_countries,
.(date, iso_a3, currency_code, name, local_price, dollar_ex, dollar_price, GDP_bigmac, adj_price)
]
for (currency in base_currencies) {
big_mac_adj_index[
, # we don't want a subset, so our first argument is blank
(currency) := # we'll add a new column named for the base set
( # we divide the dollar price by the adjusted price to get
dollar_price / adj_price # the deviation from our expectation by
) /
# the same figure from the *base currency*'s rowa\
(
.SD[currency_code == currency]$dollar_price /
.SD[currency_code == currency]$adj_price
) -
1, # one means parity (neither over- nor under-valued), so we subtract one
# to get an over/under-valuation value
by = date # and of course, we'll group these rows by date
]
}
big_mac_adj_index[, (base_currencies) := round(.SD, 5L), .SDcols = base_currencies]
fwrite(big_mac_adj_index, "./output-data/big-mac-adjusted-index.csv")
big_mac_full_index <- merge(big_mac_index, big_mac_adj_index,
by = c("date", "iso_a3", "currency_code", "name", "local_price", "dollar_ex", "dollar_price"),
suffixes = c("_raw", "_adjusted"),
all.x = TRUE
)
fwrite(big_mac_full_index, "./output-data/big-mac-full-index.csv")
View(big_mac_full_index)
