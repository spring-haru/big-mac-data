"controlled_individual","institutions_share","insiders_share","ceo_shares","chair_shares",
"nonemp_bod_shares","executive_shares","unequal_voting_all","unequal_voting_common",
"voting_score","voting_rights_per_share","voting_right_parity","env_score","soc_score",
"gov_score","community_spending","community_spending_pct_ebitda","general_donations",
"employee_turnover_1","employee_turnover_2"
)
rename_cols_by_position <- function(df, new_names) {
if (ncol(df) != length(new_names)) {
stop(
sprintf("Column count mismatch: df has %d cols but new_names has %d",
ncol(df), length(new_names))
)
}
names(df) <- new_names
df
}
sp_bbg_hangseng     <- rename_cols_by_position(sp_bbg_hangseng,     new_names_76)
sp_bbg_klse         <- rename_cols_by_position(sp_bbg_klse,         new_names_76)
